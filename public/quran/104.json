[["وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١",601,30,0],["ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ٢",601,30,0],["يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ٣",601,30,0],["كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ٤",601,30,0],["وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ٥",601,30,0],["نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ٦",601,30,0],["ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ٧",601,30,0],["إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ٨",601,30,0],["فِي عَمَدٖ مُّمَدَّدَةِۭ ٩",601,30,0]]