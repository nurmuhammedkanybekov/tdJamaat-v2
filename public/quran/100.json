[["وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ١",599,30,0],["فَٱلۡمُورِيَٰتِ قَدۡحٗا ٢",599,30,0],["فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣",599,30,0],["فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤",599,30,0],["فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥",599,30,0],["إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦",599,30,0],["وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧",599,30,0],["وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨",599,30,0],["۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩",599,30,0],["وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠",600,30,0],["إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١",600,30,0]]