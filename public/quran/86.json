[["وَٱلسَّمَآءِ وَٱلطَّارِقِ ١",591,30,0],["وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ ٢",591,30,0],["ٱلنَّجۡمُ ٱلثَّاقِبُ ٣",591,30,0],["إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ ٤",591,30,0],["فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ ٥",591,30,0],["خُلِقَ مِن مَّآءٖ دَافِقٖ ٦",591,30,0],["يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ ٧",591,30,0],["إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ٨",591,30,0],["يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ ٩",591,30,0],["فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ ١٠",591,30,0],["وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ ١١",591,30,0],["وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ ١٢",591,30,0],["إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ ١٣",591,30,0],["وَمَا هُوَ بِٱلۡهَزۡلِ ١٤",591,30,0],["إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا ١٥",591,30,0],["وَأَكِيدُ كَيۡدٗا ١٦",591,30,0],["فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ١٧",591,30,0]]