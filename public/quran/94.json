[["أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١",596,30,0],["وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢",596,30,0],["ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣",596,30,0],["وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤",596,30,0],["فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ٥",596,30,0],["إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ٦",596,30,0],["فَإِذَا فَرَغۡتَ فَٱنصَبۡ ٧",596,30,0],["وَإِلَىٰ رَبِّكَ فَٱرۡغَب ٨",596,30,0]]