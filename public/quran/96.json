[["ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ ١",597,30,0],["خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ ٢",597,30,0],["ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ ٣",597,30,0],["ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ ٤",597,30,0],["عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ٥",597,30,0],["كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ ٦",597,30,0],["أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ ٧",597,30,0],["إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ ٨",597,30,0],["أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ ٩",597,30,0],["عَبۡدًا إِذَا صَلَّىٰٓ ١٠",597,30,0],["أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ ١١",597,30,0],["أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ ١٢",597,30,0],["أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ ١٣",597,30,0],["أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ ١٤",597,30,0],["كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ ١٥",597,30,0],["نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ١٦",597,30,0],["فَلۡيَدۡعُ نَادِيَهُۥ ١٧",597,30,0],["سَنَدۡعُ ٱلزَّبَانِيَةَ ١٨",597,30,0],["كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩ ١٩",597,30,1]]