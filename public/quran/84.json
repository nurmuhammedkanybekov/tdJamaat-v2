[["إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ ١",589,30,0],["وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٢",589,30,0],["وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ ٣",589,30,0],["وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ ٤",589,30,0],["وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ٥",589,30,0],["يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ ٦",589,30,0],["فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧",589,30,0],["فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا ٨",589,30,0],["وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا ٩",589,30,0],["وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ ١٠",589,30,0],["فَسَوۡفَ يَدۡعُواْ ثُبُورٗا ١١",589,30,0],["وَيَصۡلَىٰ سَعِيرًا ١٢",589,30,0],["إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا ١٣",589,30,0],["إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ١٤",589,30,0],["بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا ١٥",589,30,0],["فَلَآ أُقۡسِمُ بِٱلشَّفَقِ ١٦",589,30,0],["وَٱلَّيۡلِ وَمَا وَسَقَ ١٧",589,30,0],["وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ ١٨",589,30,0],["لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ ١٩",589,30,0],["فَمَا لَهُمۡ لَا يُؤۡمِنُونَ ٢٠",589,30,0],["وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩ ٢١",589,30,1],["بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢",589,30,0],["وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ ٢٣",589,30,0],["فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ ٢٤",589,30,0],["إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ ٢٥",589,30,0]]