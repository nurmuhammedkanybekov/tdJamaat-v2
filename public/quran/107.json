[["أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ١",602,30,0],["فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢",602,30,0],["وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣",602,30,0],["فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤",602,30,0],["ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥",602,30,0],["ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦",602,30,0],["وَيَمۡنَعُونَ ٱلۡمَاعُونَ ٧",602,30,0]]