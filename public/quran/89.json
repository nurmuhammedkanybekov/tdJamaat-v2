[["وَٱلۡفَجۡرِ ١",593,30,0],["وَلَيَالٍ عَشۡرٖ ٢",593,30,0],["وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣",593,30,0],["وَٱلَّيۡلِ إِذَا يَسۡرِ ٤",593,30,0],["هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥",593,30,0],["أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦",593,30,0],["إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧",593,30,0],["ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨",593,30,0],["وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩",593,30,0],["وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠",593,30,0],["ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١",593,30,0],["فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢",593,30,0],["فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣",593,30,0],["إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤",593,30,0],["فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥",593,30,0],["وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦",593,30,0],["كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧",593,30,0],["وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨",593,30,0],["وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ١٩",593,30,0],["وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٠",593,30,0],["كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢١",593,30,0],["وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٢",593,30,0],["وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٣",593,30,0],["يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٤",594,30,0],["فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٥",594,30,0],["وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ٢٦",594,30,0],["يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٢٧",594,30,0],["ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٢٨",594,30,0],["فَٱدۡخُلِي فِي عِبَٰدِي ٢٩",594,30,0],["وَٱدۡخُلِي جَنَّتِي ٣٠",594,30,0]]