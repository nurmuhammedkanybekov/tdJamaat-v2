[["إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ١",587,30,0],["وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ٢",587,30,0],["وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ٣",587,30,0],["وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ٤",587,30,0],["عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ٥",587,30,0],["يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ٦",587,30,0],["ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ٧",587,30,0],["فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ٨",587,30,0],["كـَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ٩",587,30,0],["وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ١٠",587,30,0],["كِرَامٗا كَٰتِبِينَ ١١",587,30,0],["يَعۡلَمُونَ مَا تَفۡعَلُونَ ١٢",587,30,0],["إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ١٣",587,30,0],["وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ١٤",587,30,0],["يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ١٥",587,30,0],["وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ١٦",587,30,0],["وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٧",587,30,0],["ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٨",587,30,0],["يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ١٩",587,30,0]]