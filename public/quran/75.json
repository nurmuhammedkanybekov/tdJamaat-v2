[["لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ١",577,29,0],["وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ٢",577,29,0],["أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ٣",577,29,0],["بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ ٤",577,29,0],["بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥",577,29,0],["يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ٦",577,29,0],["فَإِذَا بَرِقَ ٱلۡبَصَرُ ٧",577,29,0],["وَخَسَفَ ٱلۡقَمَرُ ٨",577,29,0],["وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ٩",577,29,0],["يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ١٠",577,29,0],["كـَلَّا لَا وَزَرَ ١١",577,29,0],["إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ١٢",577,29,0],["يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ١٣",577,29,0],["بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤",577,29,0],["وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥",577,29,0],["لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ ١٦",577,29,0],["إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ ١٧",577,29,0],["فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ ١٨",577,29,0],["ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٩",577,29,0],["كـَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ ٢٠",578,29,0],["وَتَذَرُونَ ٱلۡأٓخِرَةَ ٢١",578,29,0],["وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ ٢٢",578,29,0],["إِلَىٰ رَبِّهَا نَاظِرَةٞ ٢٣",578,29,0],["وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ ٢٤",578,29,0],["تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ ٢٥",578,29,0],["كـَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ ٢٦",578,29,0],["وَقِيلَ مَنۡۜ رَاقٖ ٢٧",578,29,0],["وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ ٢٨",578,29,0],["وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ٢٩",578,29,0],["إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ ٣٠",578,29,0],["فَلَا صَدَّقَ وَلَا صَلَّىٰ ٣١",578,29,0],["وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ٣٢",578,29,0],["ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ ٣٣",578,29,0],["أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ٣٤",578,29,0],["ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ ٣٥",578,29,0],["أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ٣٦",578,29,0],["أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ ٣٧",578,29,0],["ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ ٣٨",578,29,0],["فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣٩",578,29,0],["أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ ٤٠",578,29,0]]