[["وَٱلضُّحَىٰ ١",596,30,0],["وَٱلَّيۡلِ إِذَا سَجَىٰ ٢",596,30,0],["مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣",596,30,0],["وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤",596,30,0],["وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥",596,30,0],["أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦",596,30,0],["وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧",596,30,0],["وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨",596,30,0],["فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩",596,30,0],["وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠",596,30,0],["وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١",596,30,0]]