[["ٱلۡقَارِعَةُ ١",600,30,0],["مَا ٱلۡقَارِعَةُ ٢",600,30,0],["وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ٣",600,30,0],["يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ٤",600,30,0],["وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ٥",600,30,0],["فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٦",600,30,0],["فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٧",600,30,0],["وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٨",600,30,0],["فَأُمُّهُۥ هَاوِيَةٞ ٩",600,30,0],["وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ ١٠",600,30,0],["نَارٌ حَامِيَةُۢ ١١",600,30,0]]