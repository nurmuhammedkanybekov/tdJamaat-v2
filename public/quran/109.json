[["قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ ١",603,30,0],["لَآ أَعۡبُدُ مَا تَعۡبُدُونَ ٢",603,30,0],["وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٣",603,30,0],["وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ ٤",603,30,0],["وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ ٥",603,30,0],["لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ ٦",603,30,0]]