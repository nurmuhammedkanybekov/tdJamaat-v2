[["عَمَّ يَتَسَآءَلُونَ ١",582,30,0],["عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ٢",582,30,0],["ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ٣",582,30,0],["كـَلَّا سَيَعۡلَمُونَ ٤",582,30,0],["ثُمَّ كـَلَّا سَيَعۡلَمُونَ ٥",582,30,0],["أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ٦",582,30,0],["وَٱلۡجِبَالَ أَوۡتَادٗا ٧",582,30,0],["وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ٨",582,30,0],["وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ٩",582,30,0],["وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ١٠",582,30,0],["وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ١١",582,30,0],["وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ١٢",582,30,0],["وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣",582,30,0],["وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤",582,30,0],["لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥",582,30,0],["وَجَنَّٰتٍ أَلۡفَافًا ١٦",582,30,0],["إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧",582,30,0],["يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨",582,30,0],["وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩",582,30,0],["وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ٢٠",582,30,0],["إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١",582,30,0],["لِّلطَّٰغِينَ مَـَٔابٗا ٢٢",582,30,0],["لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ٢٣",582,30,0],["لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤",582,30,0],["إِلَّا حَمِيمٗا وَغَسَّاقٗا ٢٥",582,30,0],["جَزَآءٗ وِفَاقًا ٢٦",582,30,0],["إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧",582,30,0],["وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨",582,30,0],["وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ٢٩",582,30,0],["فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ٣٠",582,30,0],["إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١",583,30,0],["حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢",583,30,0],["وَكَوَاعِبَ أَتۡرَابٗا ٣٣",583,30,0],["وَكَأۡسٗا دِهَاقٗا ٣٤",583,30,0],["لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥",583,30,0],["جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦",583,30,0],["رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ٣٧",583,30,0],["يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨",583,30,0],["ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩",583,30,0],["إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤٠",583,30,0]]