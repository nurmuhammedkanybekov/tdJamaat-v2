[["هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ١",592,30,0],["وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ٢",592,30,0],["عَامِلَةٞ نَّاصِبَةٞ ٣",592,30,0],["تَصۡلَىٰ نَارًا حَامِيَةٗ ٤",592,30,0],["تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ٥",592,30,0],["لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦",592,30,0],["لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ٧",592,30,0],["وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ٨",592,30,0],["لِّسَعۡيِهَا رَاضِيَةٞ ٩",592,30,0],["فِي جَنَّةٍ عَالِيَةٖ ١٠",592,30,0],["لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ١١",592,30,0],["فِيهَا عَيۡنٞ جَارِيَةٞ ١٢",592,30,0],["فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ١٣",592,30,0],["وَأَكۡوَابٞ مَّوۡضُوعَةٞ ١٤",592,30,0],["وَنَمَارِقُ مَصۡفُوفَةٞ ١٥",592,30,0],["وَزَرَابِيُّ مَبۡثُوثَةٌ ١٦",592,30,0],["أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ١٧",592,30,0],["وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ١٨",592,30,0],["وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ١٩",592,30,0],["وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ٢٠",592,30,0],["فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ٢١",592,30,0],["لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ٢٢",592,30,0],["إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣",592,30,0],["فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤",592,30,0],["إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥",592,30,0],["ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦",592,30,0]]