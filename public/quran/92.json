[["وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ١",595,30,0],["وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ٢",595,30,0],["وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣",595,30,0],["إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ٤",595,30,0],["فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ٥",595,30,0],["وَصَدَّقَ بِٱلۡحُسۡنَىٰ ٦",595,30,0],["فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ٧",595,30,0],["وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ٨",595,30,0],["وَكَذَّبَ بِٱلۡحُسۡنَىٰ ٩",595,30,0],["فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠",595,30,0],["وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١",595,30,0],["إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢",595,30,0],["وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣",595,30,0],["فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤",595,30,0],["لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥",596,30,0],["ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦",596,30,0],["وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧",596,30,0],["ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨",596,30,0],["وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩",596,30,0],["إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠",596,30,0],["وَلَسَوۡفَ يَرۡضَىٰ ٢١",596,30,0]]