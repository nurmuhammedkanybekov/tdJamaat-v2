[["وَٱلشَّمۡسِ وَضُحَىٰهَا ١",595,30,0],["وَٱلۡقَمَرِ إِذَا تَلَىٰهَا ٢",595,30,0],["وَٱلنَّهَارِ إِذَا جَلَّىٰهَا ٣",595,30,0],["وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا ٤",595,30,0],["وَٱلسَّمَآءِ وَمَا بَنَىٰهَا ٥",595,30,0],["وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا ٦",595,30,0],["وَنَفۡسٖ وَمَا سَوَّىٰهَا ٧",595,30,0],["فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا ٨",595,30,0],["قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا ٩",595,30,0],["وَقَدۡ خَابَ مَن دَسَّىٰهَا ١٠",595,30,0],["كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ ١١",595,30,0],["إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا ١٢",595,30,0],["فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا ١٣",595,30,0],["فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا ١٤",595,30,0],["وَلَا يَخَافُ عُقۡبَٰهَا ١٥",595,30,0]]