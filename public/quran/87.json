[["سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ١",591,30,0],["ٱلَّذِي خَلَقَ فَسَوَّىٰ ٢",591,30,0],["وَٱلَّذِي قَدَّرَ فَهَدَىٰ ٣",591,30,0],["وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ٤",591,30,0],["فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ٥",591,30,0],["سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ٦",591,30,0],["إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ٧",591,30,0],["وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ٨",591,30,0],["فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ٩",591,30,0],["سَيَذَّكَّرُ مَن يَخۡشَىٰ ١٠",591,30,0],["وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ١١",591,30,0],["ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ١٢",591,30,0],["ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ١٣",591,30,0],["قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ١٤",591,30,0],["وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ١٥",591,30,0],["بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ١٦",592,30,0],["وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ١٧",592,30,0],["إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ١٨",592,30,0],["صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ١٩",592,30,0]]