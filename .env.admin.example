# Copy this to .env.admin (gitignored) and fill in real values.
# Used ONLY for scripts/create-auth-users.js — never for the app itself,
# and the service role key must never end up in the deployed frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
